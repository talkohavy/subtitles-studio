+	// http://downloads.webmproject.org/docs/vp9/vp9-bitstream_superframe-and-uncompressed-header_v1.0.pdf
+	const lastByte = data[data.length - 1];
+	if (lastByte === undefined) {
+		return false;
+	}
+
