{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // -----------------------------------
    // Section 2: Language and Environment
    // -----------------------------------
    "lib": ["ESNext"],

    // ------------------
    // Section 3: Modules
    // ------------------
    "module": "preserve", // <--- defaults to `commonjs`. Specify what module code is generated.
    "typeRoots": ["node_modules/@types"], // Specify multiple folders that act like './node_modules/@types'.
    "types": ["jest", "node"], // ---> Specify type package names to be included without being referenced in a source file.
    "paths": {
      "@src/*": ["./src/*"]
    },

    // -----------------------------
    // Section 4: JavaScript Support
    // -----------------------------
    "checkJs": true, // without it? this config file would not apply to js/jsx files. Enable error reporting in type-checked JavaScript files.
    "allowJs": true, // Allow JavaScript files to be a part of your program. Use the 'checkJS' option to get errors from these files.

    // ---------------
    // Section 5: Emit
    // ---------------
    "rootDir": ".", // Explicit root covering src/, toolbox/tests/, and jest.config.js.

    // ------------------------
    // Section 7: Type Checking
    // ------------------------
    "noImplicitAny": false // <--- Enable error reporting for expressions and declarations with an implied 'any' type.
  },
  "include": ["src", "jest.config.ts", "toolbox"],
  "exclude": ["node_modules", "dist"]
}
