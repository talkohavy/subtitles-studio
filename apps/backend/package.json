{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Subtitles transcription server: receives an audio track, runs Whisper locally and returns word-level timestamps.",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "tsx watch --env-file-if-exists=.env --exclude ./storage src/start-server.ts",
    "build": "node build.config.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "tsc": "tsc -p tsconfig.json",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "check": "pnpm run tsc && pnpm run test"
  },
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "color-my-json": "^0.0.9",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
