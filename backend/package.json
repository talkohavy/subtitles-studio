{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Subtitles transcription server: receives an audio track, runs Whisper locally and returns word-level timestamps.",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "tsx watch --env-file-if-exists=.env --exclude ./storage src/start-server.ts",
    "build": "node build.config.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "tsc": "tsc -p tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:biome": "biome lint --error-on-warnings ./src",
    "lint:biome:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format ./src --write",
    "format:prettier": "prettier . --check --config .prettierrc.mjs --ignore-path .prettierignore",
    "format:prettier:fix": "prettier . --write --config .prettierrc.mjs --ignore-path .prettierignore",
    "test": "jest",
    "test:cov": "jest --coverage",
    "check": "pnpm run lint && pnpm run lint:biome && pnpm run format && pnpm run tsc && pnpm run test"
  },
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "color-my-json": "^0.0.9",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
