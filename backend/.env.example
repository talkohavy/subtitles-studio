# All variables are optional (defaults shown)
PORT=8000
SERVICE_NAME=subtitles-backend

# Logger
LOG_LEVEL=info
LOG_ENV=dev
USE_PRETTY_PRINT=true

# Comma separated origins allowed to call the API from a browser (the Vite dev server proxies /api, so it doesn't need this)
CORS_ALLOWED_ORIGINS=http://localhost:3004

# Uploaded audio (deleted once transcribed) and downloaded models (Whisper and the NLLB translator) live here
STORAGE_DIR=./storage
MAX_UPLOAD_MB=512

# Whisper model used when the client doesn't pick one: base | small | large-v3-turbo
DEFAULT_WHISPER_MODEL=small
# auto | cpu | webgpu ("auto" uses the GPU for large-v3-turbo when available, and falls back to the CPU)
WHISPER_DEVICE=auto
# Set to false to only use models already present in STORAGE_DIR/models (offline mode)
ALLOW_REMOTE_MODELS=true
# How long a finished transcription or translation stays available
JOB_TTL_MINUTES=60

# Served (with an SPA fallback) when it exists, so production needs a single server
FRONTEND_DIST_DIR=../frontend/dist
