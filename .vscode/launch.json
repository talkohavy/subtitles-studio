{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // -----------------
    // Run Current File:
    // -----------------
    {
      "type": "node",
      "request": "launch",
      "name": "Current File",
      "runtimeExecutable": "node",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${file}",
      "smartStep": true,
      "outputCapture": "std", // This is to be able to also capture logger outputs
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    // -------
    // backend
    // -------
    // Same as `pnpm dev:backend`, with the debugger attached. Workers are forked child processes, so
    // `autoAttachChildProcesses` lets breakpoints in them hit too.
    {
      "name": "backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "runtimeExecutable": "${workspaceFolder}/apps/backend/node_modules/.bin/tsx",
      "runtimeArgs": ["watch", "--clear-screen=false", "--env-file-if-exists=.env", "--exclude", "./storage"],
      "program": "src/start-server.ts",
      "autoAttachChildProcesses": true,
      "restart": true, // Try to reconnect to a program if we lose connection. If set to `true`, we'll try once every second, forever.
      "outputCapture": "std", // This is to be able to also capture logger outputs
      "sourceMaps": true,
      // Files to exclude from debugger (e.g. call stack)
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    // ----------------------
    // Debug React in VSCode:
    // ----------------------
    // Run the frontend as you normally do (`pnpm dev:frontend`).
    // Then, run this debugger configuration. It would open a new Chrome window and attach to it.
    {
      "type": "chrome",
      "request": "launch",
      "name": "frontend",
      "url": "http://localhost:3004",
      "webRoot": "${workspaceFolder}/apps/frontend/src",
      "sourceMaps": true,
      "smartStep": true,
      "outputCapture": "std" // This is to be able to also capture logger outputs
    }
  ]
}
