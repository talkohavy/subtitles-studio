{
  "name": "subtitles-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Drop a video, get AI-generated subtitles from its audio, style them, and export the video with the subtitles burned in.",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "build": "pnpm --filter frontend run build && pnpm --filter backend run build",
    "start": "pnpm --filter backend run start",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "tsc": "pnpm --recursive run tsc",
    "check": "pnpm --recursive run check",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
